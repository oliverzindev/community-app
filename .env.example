# Community Rep — variáveis de ambiente (web)

# Pesquisa (API routes /api/*). Vazio = usa a mesma origem (este site).
NEXT_PUBLIC_API_URL=

# Chave do fornecedor de dados do Xianyu (Apify). Define no Vercel para ligar a pesquisa.
APIFY_TOKEN=
# Fornecedor: gantianca | khadinakbar
SEARCH_PROVIDER=gantianca

# Tradução premium opcional (PT-PT). Sem isto, usa o MyMemory gratuito.
DEEPL_KEY=
MYMEMORY_EMAIL=

# Donos/administradores da plataforma (dois e-mails separados por vírgula).
# Usados para as contas de dono quando o sistema de login estiver pronto (Onda 2).
OWNER_EMAILS=
